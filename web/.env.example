# ---------------------------------------------------------------------------
# Model endpoint
#
# The application is vendor-neutral. It speaks one wire format — the widely
# implemented chat-completions shape — and knows only a base URL, a key and a
# model name. Any service exposing that format works; see README.md for base
# URLs that are known to work, including free and locally hosted options.
#
# Leave these unset to run with no endpoint at all: the app serves a built-in
# sample paper and written responses are shown with their marking guideline
# instead of a mark.
#
# Check a configuration with:  pnpm ai:smoke
# ---------------------------------------------------------------------------
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional per-stage models. Anything unset falls back to AI_MODEL.
# Generating questions can use a cheaper model than marking them, because a
# weak mark on a correct answer costs far more trust than a weak question.
# AI_MODEL_BLUEPRINT=
# AI_MODEL_QUESTION=
# AI_MODEL_CRITIC=
# AI_MODEL_MARKING=
# AI_MODEL_MODERATION=

# ---------------------------------------------------------------------------
# What the model is used for. These are separate decisions: producing a paper
# is ~100 calls, marking one is ~30 small ones.
#
#   GENERATION_PROVIDER  sample | model   (default: sample)
#   MARKING_PROVIDER     none   | model   (default: model once an endpoint is set)
# ---------------------------------------------------------------------------
GENERATION_PROVIDER=sample
# MARKING_PROVIDER=

# SQLite database location (relative to web/)
DATABASE_URL=file:./data/app.db

# Container only: set to `never` to skip corpus ingestion on first start.
# INGEST_ON_START=auto
